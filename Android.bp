soong_namespace {
    imports: [],
}

android_app_import {
    name: "NexusLauncherRelease",
    owner: "pixel/launcher",
    apk: "proprietary/system_ext/priv-app/NexusLauncherRelease/NexusLauncherRelease.apk",
    preprocessed: true,
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
    optional_uses_libs: [
        "com.android.extensions.appfunctions",
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
    privileged: true,
    system_ext_specific: true,
}
